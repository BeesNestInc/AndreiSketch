{
  "name": "sp_search_term_daily",
  "report": {
    "adProduct": "SPONSORED_PRODUCTS",
    "reportTypeId": "spSearchTerm",
    "timeUnit": "DAILY",
    "groupBy": ["searchTerm"]
  },
  "columns": [
    { "name": "profile_id", "type": "bigint", "null": false },

    { "name": "date", "type": "date", "null": false, "source": "date" },

    { "name": "campaign_id", "type": "bigint", "null": false, "source": "campaignId" },

    { "name": "ad_group_id", "type": "bigint", "null": false, "default": "0", "source": "adGroupId" },
    { "name": "keyword_id", "type": "bigint", "null": false, "default": "0", "source": "keywordId" },
    { "name": "match_type", "type": "text", "null": false, "default": "''", "source": "matchType" },

    { "name": "search_term", "type": "text", "null": false, "source": "searchTerm" },

    { "name": "impressions", "type": "bigint", "null": true, "source": "impressions" },
    { "name": "clicks", "type": "bigint", "null": true, "source": "clicks" },
    { "name": "cost", "type": "numeric(12,2)", "null": true, "source": "cost" },

    { "name": "raw_run_id", "type": "text", "null": false },
    { "name": "ingested_at", "type": "timestamptz", "null": false, "default": "now()" }
  ],
  "unique": [
    ["profile_id", "date", "campaign_id", "ad_group_id", "keyword_id", "match_type", "search_term"]
  ],
  "indexes": [
    ["profile_id", "date"],
    ["campaign_id"],
    ["search_term"]
  ]
}
