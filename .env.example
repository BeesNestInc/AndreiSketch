# --- Amazon Ads API credentials ---
# 以下はAmazon AdsのAPI登録をすると取得できる
AMZ_LWA_CLIENT_ID='amzn1.application-oa2-client.XXXX'
AMZ_LWA_CLIENT_SECRET='amzn1.oa2-cs.v1.XXXXXXXXXX'
# 上2つがあれば、get-profile-id.jsが実行できる
# 以下はget-profile-id.jsを実行すると取得できる
AMZ_ADS_API_BASE=https://advertising-api-fe.amazon.com
AMZ_ADS_PROFILE_ID=XXXXXXXXXXXXXXXXX

# そこで出力されたURLをリンクすると、承認画面が開く。その結果「許可コード」を
# code=XXXとして取得できる。
AMZ_LWA_REFRESH_TOKEN='Atzr|XXXX'

# Ads profile (aka scope)

# LWA token endpoint (FE)
AMZ_LWA_TOKEN_URL=https://api.amazon.com/auth/o2/token

# ここはLWAのSecurity Profileで「Allowed Return URLs」に登録済みのURLにする
# scope はまずこれでOK
AMZ_LWA_SCOPE=advertising::campaign_management
#AMZ_LWA_SCOPE=cpc_advertising:campaign_management
# （任意）profile APIも叩きたいならこうする：
#AMZ_LWA_SCOPE=advertising::campaign_management profile

AMZ_LWA_AUTHORIZE_URL=https://apac.account.amazon.com/ap/oa

# print-auth-url.jsで生成するリダイレクト先URL
AMZ_LWA_REDIRECT_URI='https://localhost/lwa-callback'

# --- Output ---
ADS_DATA_DIR=./data

# --- Report config (override any time) ---
REPORT_DAYS=32              # default: last 30 days ending yesterday

# --- Polling / retry ---
POLL_MAX_SECONDS=900        # 15 minutes
POLL_INITIAL_DELAY_MS=3000
POLL_MAX_DELAY_MS=30000
HTTP_TIMEOUT_MS=30000

